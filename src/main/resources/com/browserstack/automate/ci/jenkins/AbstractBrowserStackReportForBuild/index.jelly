<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
	<style>
        .table-container {
            overflow-x: auto;
            width: 100%;
        }

        .new-container {
            margin-top: 10px;
            padding: 16px 24px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-family: -apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif,Apple Color Emoji,Segoe UI Emoji, sans-serif;
            font-size: 14px;
            /* box-sizing: border-box; */
        }

        .bstack-table {
            border-collapse: collapse;
            width: 100%;
            border: 1px solid #ccc;
        }

        .bstack-header {
            height: 25px;
            text-align: center;
            font-size: 14px;
            padding: 10px;
            border: 1px solid #ccc;
        }

        .bstack-data {
            height: 20px;
            text-align: center;
            padding: 10px;
            border: 1px solid #ccc;
            border-bottom: 0;
            border-top: 0;
        }

        .session-name {
            text-align: left;
        }

        .bstack-row:nth-child(even) {
            background-color: #f5f5f5;
        }

        .no-report-para {
            line-height: 1.5;
            color: #333;
        }

        .strong-font-custom {
            font-weight: 700;
        }

        .bullet-points {
            list-style: disc;
        }

        .bullet-item {
            color: #333;
            margin: 8px 0;
            line-height: 1.5;
            margin-left: 24px;
        }

        .titlecase-data {
            text-transform: capitalize;
        }

        .error-span {
            font-family: monospace;
            color: #333;
            padding: 2px 8px;
            border-radius: 4px;
            border: 1px solid #aaa;
            font-weight: 400;
            font-size: 12px;
            color: #DD4B4B;
            border-color: #DD4B4B;
        }

        .bstack-ai-banner {
            margin: 12px 0 20px;
            padding: 20px 24px;
            border: 1px solid #e4e7ec;
            border-radius: 10px;
            background: linear-gradient(105deg, #eef4ff 0%, #f7f8fc 45%, #fff6ef 100%);
            font-family: -apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif;
            color: #1b1b2f;
        }

        .bstack-ai-banner-title {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bstack-ai-banner-stats {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px 16px;
            margin-top: 8px;
            font-size: 13px;
            color: #475467;
        }

        .bstack-ai-banner-stat strong {
            color: #1b1b2f;
            font-weight: 600;
        }

        .bstack-ai-banner-stat-divider {
            color: #d0d5dd;
        }

        .bstack-ai-agent-tiles {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        .bstack-ai-agent-tile {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 16px;
            background: #ffffff;
            border: 1px solid #e4e7ec;
            border-radius: 8px;
            text-decoration: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .bstack-ai-agent-tile:hover {
            border-color: #b39ddb;
            box-shadow: 0 2px 8px rgba(116, 52, 217, 0.12);
        }

        .bstack-ai-agent-iconwrap {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: #f3edff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bstack-ai-agent-icon {
            color: #7434d9;
            width: 20px;
            height: 20px;
        }

        .bstack-ai-agent-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .bstack-ai-agent-title {
            font-size: 14px;
            font-weight: 600;
            color: #1b1b2f;
            line-height: 1.3;
        }

        .bstack-ai-agent-name {
            font-size: 12px;
            color: #667085;
        }

	</style>
	<l:layout>
        <st:include it="${it.build}" page="sidepanel.jelly"/>
        <l:main-panel>
            <div class="bstack-ai-banner">
                <div class="bstack-ai-banner-title">
                    <span>Power your workflows with AI Agents</span>
                    <span>&#10024;</span>
                </div>
                <div class="bstack-ai-banner-stats">
                    <span class="bstack-ai-banner-stat">&#128101; <strong>500+ teams</strong> testing faster with AI</span>
                    <span class="bstack-ai-banner-stat-divider">|</span>
                    <span class="bstack-ai-banner-stat">&#128200; <strong>15+ hours</strong> saved weekly per team</span>
                </div>
                <div class="bstack-ai-agent-tiles">
                    <a class="bstack-ai-agent-tile" href="${it.healingAgentUrl}" target="_blank" rel="noreferrer noopener">
                        <span class="bstack-ai-agent-iconwrap">
                            <svg class="bstack-ai-agent-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/>
                                <path d="M3.5 12h4l1.5-3 2.5 6 1.5-3h4.5"/>
                            </svg>
                        </span>
                        <span class="bstack-ai-agent-text">
                            <span class="bstack-ai-agent-title">Auto-heal broken locators</span>
                            <span class="bstack-ai-agent-name">Self-Healing Agent</span>
                        </span>
                    </a>
                    <a class="bstack-ai-agent-tile" href="${it.tfaAgentUrl}" target="_blank" rel="noreferrer noopener">
                        <span class="bstack-ai-agent-iconwrap">
                            <svg class="bstack-ai-agent-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="7"/>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                        </span>
                        <span class="bstack-ai-agent-text">
                            <span class="bstack-ai-agent-title">AI-powered test failure analysis</span>
                            <span class="bstack-ai-agent-name">Test Failure Analysis Agent</span>
                        </span>
                    </a>
                    <a class="bstack-ai-agent-tile" href="${it.smartSelectionAgentUrl}" target="_blank" rel="noreferrer noopener">
                        <span class="bstack-ai-agent-iconwrap">
                            <svg class="bstack-ai-agent-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                            </svg>
                        </span>
                        <span class="bstack-ai-agent-text">
                            <span class="bstack-ai-agent-title">Run only impacted tests</span>
                            <span class="bstack-ai-agent-name">Smart Test Selection Agent</span>
                        </span>
                    </a>
                    <a class="bstack-ai-agent-tile" href="${it.nlAutomationAgentUrl}" target="_blank" rel="noreferrer noopener">
                        <span class="bstack-ai-agent-iconwrap">
                            <svg class="bstack-ai-agent-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                            </svg>
                        </span>
                        <span class="bstack-ai-agent-text">
                            <span class="bstack-ai-agent-title">Author tests in natural language</span>
                            <span class="bstack-ai-agent-name">NL Test Automation Agent</span>
                        </span>
                    </a>
                </div>
            </div>

            <j:if test="${(it.result.result.size() == 0)}">
                <div class="new-container">
                    <div class="report-row">
                        <p class="no-report-para"><strong class="strong-font-custom">No BrowserStack Report Available</strong></p>
                        <br/>
                        <p class="no-report-para">BrowserStack test report could not be generated for this build. Please ensure that:</p>
                        <br/>
                        <ul class="bullet-points">
                            <li class="bullet-item">You have set valid BrowserStack credentials via BrowserStack Plugin.</li>
                            <li class="bullet-item">You are using ‘BROWSERSTACK_BUILD_NAME’ environment variable to set Automate build name <code>capability[‘build’]</code> in test cases.</li>
                            <li class="bullet-item">Refer to the <a href="https://www.browserstack.com/docs/automate/selenium/jenkins?ref=jenkins_plugin" target="_blank"> Automate Jenkins documentation</a> for more details.</li>
                        </ul>
                    </div>
                </div>
            </j:if>

            <j:if test="${(it.result.result.size() > 0)}">
                <div style="border-style: solid;border-width: thin;">
                    <div align="center">
                        <h3>
                            Build Name: <a href="${it.browserStackBuildBrowserUrl}" target="_blank">${it.buildName}</a>
                         </h3>
                    </div>
                </div>
                <div class="table-container">
                    <table class="bstack-table">
                        <tr class="bstack-row">
                            <th class="bstack-header">Name</th>
                            <th class="bstack-header">Status</th>
                            <th class="bstack-header">REST API</th>
                            <th class="bstack-header">Browser/Device</th>
                            <th class="bstack-header">OS</th>
                            <th class="bstack-header">Duration</th>
                            <th class="bstack-header">Created At</th>
                        </tr>
                        <j:forEach items="${it.result.result}" var="i">
                            <tr class="bstack-row">
                                <td class="bstack-data session-name"><a href="${i.url}" target="_blank">${i.name}</a></td>
                                <td class="bstack-data titlecase-data">
                                    <j:if test="${(it.errorConst.equalsIgnoreCase(i.status))}">
                                        <span class="error-span">${i.status}</span>
                                    </j:if>
                                    <j:if test="${(it.errorConst.equalsIgnoreCase(i.status) == false)}">
                                        <span>${i.status}</span>
                                    </j:if>
                                </td>
                                <td class="bstack-data titlecase-data">
                                    <j:if test="${(it.failedConst.equalsIgnoreCase(i.userMarked))}">
                                        <span class="error-span">${i.userMarked}</span>
                                    </j:if>
                                    <j:if test="${(it.failedConst.equalsIgnoreCase(i.userMarked) == false)}">
                                        <span>${i.userMarked}</span>
                                    </j:if>
                                </td>
                                <td class="bstack-data titlecase-data">${i.browser}</td>
                                <td class="bstack-data">${i.os}</td>
                                <td class="bstack-data">${i.duration}</td>
                                <td class="bstack-data">${i.createdAtReadable}</td>
                            </tr>
                        </j:forEach>
                    </table>
                </div>
            </j:if>
        </l:main-panel>
    </l:layout>
</j:jelly>
